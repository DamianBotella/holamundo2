    {
      "id": "fm-04",
      "name": "Build Form HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        220
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst token = ($('Webhook GET').first().json.query || {}).token || '';\nconst N8N = 'https://n8n-n8n.zzeluw.easypanel.host';\nconst submitUrl = N8N + '/webhook/aftercare-public-submit';\nconst html = '<!DOCTYPE html><html lang=\"es\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Reportar incidencia</title>' +\n'<style>body{font-family:-apple-system,Arial,sans-serif;max-width:600px;margin:24px auto;padding:16px;color:#1f2937}h1{color:#2c3e50;font-size:22px}label{display:block;margin-top:16px;font-weight:600;font-size:14px}input,textarea{width:100%;padding:10px;border:1px solid #d1d5db;border-radius:6px;font-size:15px;box-sizing:border-box}textarea{min-height:120px;resize:vertical}.help{color:#6b7280;font-size:12px;margin-top:4px}button{background:#2563eb;color:white;padding:14px 24px;border:0;border-radius:6px;font-size:16px;cursor:pointer;margin-top:24px;width:100%}button:hover{background:#1d4ed8}.proj{background:#f3f4f6;padding:12px;border-radius:6px;margin-bottom:16px;font-size:14px}.ok{background:#d1fae5;color:#065f46;padding:12px;border-radius:6px;display:none;margin-top:16px}.err{background:#fee2e2;color:#991b1b;padding:12px;border-radius:6px;display:none;margin-top:16px}</style></head><body>' +\n'<h1>Reportar una incidencia</h1>' +\n'<div class=\"proj\">Proyecto: <b>' + (r.project_name || '?') + '</b></div>' +\n'<div id=\"ok\" class=\"ok\"></div><div id=\"err\" class=\"err\"></div>' +\n'<form id=\"f\">' +\n'<label>Que ha pasado?</label>' +\n'<textarea id=\"d\" placeholder=\"Describe la incidencia con detalle. Donde, desde cuando, si esta empeorando.\"></textarea>' +\n'<label>URL de la foto (opcional)</label>' +\n'<input type=\"url\" id=\"p\" placeholder=\"https://...\">' +\n'<div class=\"help\">Sube primero a Drive/iCloud/imgur y pega aqui el enlace publico.</div>' +\n'<label>Tu email de contacto (opcional)</label>' +\n'<input type=\"email\" id=\"c\" placeholder=\"tucorreo@ejemplo.com\">' +\n'<button type=\"submit\">Enviar incidencia</button>' +\n'</form>' +\n'<script>document.getElementById(\"f\").addEventListener(\"submit\",async e=>{e.preventDefault();const t=\"' + token + '\";const d=document.getElementById(\"d\").value.trim();const p=document.getElementById(\"p\").value.trim();const c=document.getElementById(\"c\").value.trim();if(d.length<10){document.getElementById(\"err\").style.display=\"block\";document.getElementById(\"err\").textContent=\"Describe la incidencia con al menos 10 caracteres.\";return}try{const r=await fetch(\"' + submitUrl + '\",{method:\"POST\",headers:{\"Content-Type\":\"application/json\"},body:JSON.stringify({token:t,description:d,photo_url:p,client_contact:c})});const j=await r.json();if(j.status===\"ok\"){document.getElementById(\"f\").style.display=\"none\";document.getElementById(\"ok\").style.display=\"block\";document.getElementById(\"ok\").innerHTML=\"<b>Incidencia registrada.</b><br>Referencia: \"+j.incident_id}else{document.getElementById(\"err\").style.display=\"block\";document.getElementById(\"err\").textContent=j.error||\"No se pudo registrar.\"}}catch(x){document.getElementById(\"err\").style.display=\"block\";document.getElementById(\"err\").textContent=\"Error de conexion. Intentalo de nuevo.\"}});</script>' +\n'</body></html>';\nreturn [{ json: { html: html } }];"
      }
    },
