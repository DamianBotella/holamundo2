      "name": "Prepare Security Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        500
      ],
      "parameters": {
        "jsCode": "const wh = $('Manual Trigger').first().json || {};\nconst headers = wh.headers || {};\nconst sourceIp = headers['x-real-ip']\n  || (headers['x-forwarded-for'] || '').toString().split(',')[0].trim()\n  || 'unknown';\nconst out = {\n  source_ip: sourceIp,\n  user_agent: headers['user-agent'] || 'unknown',\n  endpoint: '/webhook/trigger-audits-cron',\n  max_per_minute: 10,\n  agent_name: 'cron_post_phase_audits'\n};\nreturn [{ json: out }];"
      }
    },
