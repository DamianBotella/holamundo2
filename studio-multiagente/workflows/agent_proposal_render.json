        "jsCode": "const resp = $input.first()?.json || {};\nconst prep = $('Prepare MNML Request').first().json;\nconst id = resp.id || resp.requestId || resp.request_id || null;\nif (!id) {\n  return [{ json: { _error: 'MNML_SUBMIT_FAILED', _status: 502, _details: 'MNML no devolvio id: ' + JSON.stringify(resp).slice(0, 400), request_id: prep.request_id }}];\n}\nreturn [{ json: {\n  proposal_id: prep.proposal_id,\n  project_id: prep.project_id,\n  request_id: prep.request_id,\n  mnml_id: id,\n  mnml_api_key: prep.mnml_api_key,\n  mnml_initial_status: resp.status || 'submitted',\n  prompt: prep.prompt,\n  source_image_url: prep.source_image_url,\n  style: prep.style,\n  image_type: prep.image_type,\n  poll_count: 0\n}}];"
