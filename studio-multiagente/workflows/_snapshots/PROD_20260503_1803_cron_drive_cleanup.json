{
  "name": "cron_drive_cleanup",
  "active": true,
  "nodes": [
    {
      "id": "cdc-01",
      "name": "Schedule Monthly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -700,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "months",
              "monthsInterval": 1,
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 4,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "cdc-02",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -700,
        500
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "trigger-drive-cleanup",
        "responseMode": "lastNode",
        "authentication": "headerAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER",
          "name": "Webhook API Key (entrante)"
        }
      },
      "webhookId": "066d4df8-0c4c-4aea-bd95-bd78d1eea204"
    },
    {
      "id": "cdc-03",
      "name": "Compute Cutoff",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        400
      ],
      "parameters": {
        "jsCode": "const cutoff = new Date(Date.now() - 90*24*60*60*1000).toISOString();\nreturn [{ json: { cutoff, started_at: Date.now() } }];"
      }
    },
    {
      "id": "cdc-04",
      "name": "List Old Backups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -220,
        400
      ],
      "parameters": {
        "method": "GET",
        "url": "https://www.googleapis.com/drive/v3/files",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "=name contains 'arquitai_backup_' and createdTime < '{{ $json.cutoff }}' and trashed = false"
            },
            {
              "name": "fields",
              "value": "files(id,name,createdTime,size)"
            },
            {
              "name": "pageSize",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "PLACEHOLDER",
          "name": "damian2botella"
        }
      },
      "retryOnFail": true,
      "maxTries": 2
    },
    {
      "id": "cdc-05",
      "name": "Split Files",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        20,
        400
      ],
      "parameters": {
        "fieldToSplitOut": "files",
        "options": {}
      }
    },
    {
      "id": "cdc-06",
      "name": "Delete File",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        260,
        320
      ],
      "parameters": {
        "resource": "file",
        "operation": "deleteFile",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.id }}",
          "mode": "id"
        },
        "options": {}
      },
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "PLACEHOLDER",
          "name": "damian2botella"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "cdc-07",
      "name": "Aggregate Deletions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        400
      ],
      "parameters": {
        "jsCode": "const deleted = $('Split Files').all().map(i => ({\n  id: i.json.id,\n  name: i.json.name,\n  createdTime: i.json.createdTime,\n  size: i.json.size\n}));\nconst totalBytes = deleted.reduce((a, f) => a + (parseInt(f.size, 10) || 0), 0);\nreturn [{ json: { deleted_count: deleted.length, total_bytes_freed: totalBytes, files: deleted, cutoff: $('Compute Cutoff').first().json.cutoff } }];"
      }
    },
    {
      "id": "cdc-08",
      "name": "Notify Cleanup",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        780,
        400
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $('Load Architect Email').first().json.value }}",
        "subject": "=ArquitAI — cleanup backups Drive: {{ $json.deleted_count }} eliminados",
        "emailType": "html",
        "message": "=<h3>Cleanup de backups antiguos</h3>\n<p>Cutoff: {{ $json.cutoff }} (90 días)</p>\n<p>Eliminados: {{ $json.deleted_count }} archivos</p>\n<p>Espacio liberado: {{ Math.round($json.total_bytes_freed / 1024) }} KB</p>",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "PLACEHOLDER",
          "name": "damian2botella"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "293b0250-ca32-443e-af79-143a4ea7b0b8",
      "name": "Load Architect Email",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -580,
        400
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT value FROM system_config WHERE key = 'architect_email'",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER",
          "name": "Postgres account"
        }
      }
    }
  ],
  "connections": {
    "Compute Cutoff": {
      "main": [
        [
          {
            "node": "List Old Backups",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List Old Backups": {
      "main": [
        [
          {
            "node": "Split Files",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Files": {
      "main": [
        [
          {
            "node": "Aggregate Deletions",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Delete File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Delete File": {
      "main": [
        [
          {
            "node": "Split Files",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aggregate Deletions": {
      "main": [
        [
          {
            "node": "Notify Cleanup",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Schedule Monthly": {
      "main": [
        [
          {
            "node": "Load Architect Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Load Architect Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load Architect Email": {
      "main": [
        [
          {
            "node": "Compute Cutoff",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "qfQWaGSpyjgdeFt5",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  },
  "pinData": null,
  "versionId": "3d7afa32-2f85-40e7-bf55-3c6bc64fc9f5",
  "tags": []
}