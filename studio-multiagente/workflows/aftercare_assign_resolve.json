      "position": [
        240,
        120
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({status:'assigned', incident_id: $('Apply Assign').first().json.id, assigned_to: $('Apply Assign').first().json.assigned_to, incident_status: $('Apply Assign').first().json.status, severity: $('Apply Assign').first().json.severity, gremio_notified: ($('Validate Assign').first().json.notify_email || '').includes('@')}) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
