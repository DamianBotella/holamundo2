    {
      "id": "ar-02",
      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        300
      ],
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nif (!body.anomaly_id) { const e = { valid: false, error: 'anomaly_id obligatorio' }; return [{ json: e }]; }\nconst valid = ['reviewed','accepted','dismissed','escalated'];\nif (!body.status || !valid.includes(body.status)) {\n  const e = { valid: false, error: 'status debe ser uno de: ' + valid.join(', ') };\n  return [{ json: e }];\n}\nconst out = {\n  valid: true,\n  anomaly_id: body.anomaly_id,\n  new_status: body.status,\n  reviewed_by: body.reviewed_by || 'arquitecto',\n  notes: (body.notes || '').toString().slice(0, 1000)\n};\nreturn [{ json: out }];"
      }
    },
    {
      "id": "ar-03",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -220,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "v1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "ar-04",
      "name": "Apply Update",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        20,
        220
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE anomalies_detected\n   SET status = $2,\n       reviewed_by = $3,\n       notes = COALESCE(notes || E'\\n', '') || COALESCE(NULLIF($4,''), '')\n WHERE id = $1::uuid\nRETURNING id, status, anomaly_type, severity, description, reviewed_at;",
        "options": {
          "queryReplacement": "={{ [ $json.anomaly_id, $json.new_status, $json.reviewed_by, $json.notes || '' ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "cfxNZdzy0NB3xkYC",
          "name": "Postgres account"
        }
      }
    },
    {
