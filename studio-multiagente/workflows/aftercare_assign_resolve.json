    {
      "id": "ar-11",
      "name": "Validate Resolve",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        600
      ],
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nif (!body.incident_id) { const e = { valid: false, error: 'incident_id obligatorio' }; return [{ json: e }]; }\nlet evidence = body.evidence_urls || (body.evidence_url ? [body.evidence_url] : []);\nif (!Array.isArray(evidence)) evidence = [];\nevidence = evidence.filter(u => typeof u === 'string' && u.startsWith('http')).slice(0, 5);\nconst out = {\n  valid: true,\n  incident_id: body.incident_id,\n  resolution_notes: (body.resolution_notes || '').toString().slice(0, 2000),\n  evidence_urls: evidence,\n  status: body.status === 'closed' ? 'closed' : 'resolved'\n};\nreturn [{ json: out }];"
      }
    },
    {
      "id": "ar-12",
      "name": "Resolve Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -220,
        600
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "v1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "ar-13",
      "name": "Apply Resolve",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        20,
        520
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE aftercare_incidents\n   SET status = $2,\n       resolution_notes = $3,\n       resolved_evidence = CASE WHEN array_length($4::text[], 1) IS NOT NULL THEN $4::text[] ELSE resolved_evidence END\n WHERE id = $1::uuid\nRETURNING id, status, severity, responsible_trade, resolved_at;",
        "options": {
          "queryReplacement": "={{ [ $json.incident_id, $json.status, $json.resolution_notes || '', '{' + ($json.evidence_urls || []).map(u => '\"' + u.replace(/\"/g, '\\\\\"') + '\"').join(',') + '}' ] }}"
        }
      },
      "credentials": {
