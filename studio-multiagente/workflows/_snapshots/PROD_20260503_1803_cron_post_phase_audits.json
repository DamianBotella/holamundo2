{
  "name": "cron_post_phase_audits",
  "active": true,
  "nodes": [
    {
      "id": "cpa-01",
      "name": "Schedule 30min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      }
    },
    {
      "id": "cpa-02",
      "name": "Find Pending Audits",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        250,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT 'accessibility' as audit_type, p.id as project_id, p.name as project_name FROM projects p WHERE p.status = 'active' AND p.current_phase IN ('design_done','analysis_done','costs_done','trades_done','proposal_done','approved','planning_done') AND NOT EXISTS (SELECT 1 FROM accessibility_audits a WHERE a.project_id = p.id AND a.created_at > NOW() - INTERVAL '30 days') UNION ALL SELECT 'safety_plan' as audit_type, p.id as project_id, p.name as project_name FROM projects p WHERE p.status = 'active' AND p.current_phase IN ('approved','planning_done') AND NOT EXISTS (SELECT 1 FROM safety_plans s WHERE s.project_id = p.id AND s.created_at > NOW() - INTERVAL '60 days') ORDER BY audit_type, project_name",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER",
          "name": "Postgres account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "cpa-03",
      "name": "Has Pending?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.project_id }}",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "cpa-04",
      "name": "Route by Audit Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        750,
        300
      ],
      "parameters": {
        "rules": {
          "values": [
