{
  "name": "cron_gdpr_retention",
  "active": true,
  "nodes": [
    {
      "id": "gr-01",
      "name": "Schedule Monthly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 4 1 * *"
            }
          ]
        }
      }
    },
    {
      "id": "gr-02",
      "name": "Find Clients To Anonymize",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        250,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT DISTINCT c.id as client_id, c.name as client_name, MAX(p.updated_at) as last_project_update FROM clients c JOIN projects p ON p.client_id = c.id WHERE c.email NOT LIKE 'anon-%@anonymized.local' AND p.current_phase IN ('archived','completed') GROUP BY c.id, c.name HAVING MAX(p.updated_at) < NOW() - INTERVAL '10 years' LIMIT 50",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER",
          "name": "Postgres account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "gr-03",
      "name": "Has Candidates?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.client_id }}",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "gr-04",
      "name": "Anonymize Each",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        750,
        200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT anonymize_client($1::uuid) as result",
        "options": {
          "queryReplacement": "={{ [$json.client_id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER",
          "name": "Postgres account"
        }
      },
      "continueOnFail": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "gr-05",
      "name": "Log No Candidates",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        750,
        400
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO activity_log (agent_name, action, status, output_summary) VALUES ('cron_gdpr_retention', 'monthly_check', 'success', 'No clients to anonymize at this run')",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "gr-06",
      "name": "Aggregate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst count = items.length;\nconst clients = items.map(i => i.json.result || i.json).filter(r => r);\nreturn [{ json: { anonymized_count: count, results: clients } }];"
      }
    },
    {
      "id": "gr-07",
      "name": "Log Anonymizations",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1250,
        200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO activity_log (agent_name, action, status, output_summary) VALUES ('cron_gdpr_retention', 'monthly_check', 'success', 'Anonymized ' || $1::text || ' clients post-10y archived')",
        "options": {
          "queryReplacement": "={{ [$json.anonymized_count] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "2e96f685-fb7c-4d8c-9b93-de356f687917",
      "name": "Init Super Admin Context",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        120,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT set_config('app.role', 'super_admin', false) AS role_set"
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER",
          "name": "Postgres account"
        }
      }
    }
  ],
  "connections": {
