{
  "name": "api_billing_subscription_status",
  "_description": "Fase G - GET estado de subscripcion del tenant: tier actual, status (trialing/active/past_due/...), trial_ends_at, usage del mes, limits del plan, features disponibles. Lo consume el frontend para mostrar banner trial, bloquear features fuera de plan, mostrar usage gauge.",
  "_status": "B72-fase-G billing status",
  "_n8n_id": "gFlcNWjWbIASn52h",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "api/v1/billing/subscription",
        "responseMode": "responseNode",
        "options": {}
