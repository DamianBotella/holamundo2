    {
      "id": "bd-02",
      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        300
      ],
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nif (!body.drive_file_id) { const e = { valid: false, error: 'drive_file_id obligatorio' }; return [{ json: e }]; }\nreturn [{ json: { valid: true, drive_file_id: body.drive_file_id, format: body.format || 'json' } }];"
      }
    },
    {
      "id": "bd-03",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -220,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "v1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "bd-04",
      "name": "Download from Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        20,
        220
      ],
      "parameters": {
        "resource": "file",
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.drive_file_id }}",
          "mode": "id"
        },
        "options": {}
      },
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "PLACEHOLDER",
          "name": "damian2botella"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "bd-05",
      "name": "Decrypt SQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        240,
        220
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT pii_decrypt(decode($1, 'base64'))::jsonb AS decrypted_snapshot;",
        "options": {
          "queryReplacement": "={{ [ $json.encrypted_b64 ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "bd-06",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        460,
        220
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({status:'decrypted', drive_file_id: $('Validate').first().json.drive_file_id, snapshot: $json.decrypted_snapshot}) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "bd-07",
      "name": "Drive Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        240,
        380
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({status:'drive_error', error: ($json.message || 'No se pudo descargar el archivo de Drive')}) }}",
        "options": {
          "responseCode": 502
        }
      }
    },
    {
      "id": "bd-08",
      "name": "Respond 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        20,
        460
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({status:'error', error: $json.error}) }}",
        "options": {
          "responseCode": 400
        }
      }
    },
    {
      "id": "bd-extract",
      "name": "Extract Binary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        220
      ],
      "parameters": {
        "jsCode": "const item = $input.first();\nconst buf = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst b64 = buf.toString('base64');\nreturn [{ json: { encrypted_b64: b64, byte_size: buf.length, drive_file_id: item.json.drive_file_id || '' } }];"
      }
    }
  ],
