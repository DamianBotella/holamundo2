    {
      "id": "bc-02",
      "name": "Delete Expired Bans",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -460,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH deleted AS (\n  DELETE FROM ip_blocklist\n   WHERE blocked_until < now() - INTERVAL '7 days'\n  RETURNING source_ip, hit_count, reason, blocked_until\n)\nSELECT json_build_object(\n  'rows_deleted', count(*),\n  'sample',       (SELECT array_agg(source_ip) FROM (SELECT source_ip FROM deleted LIMIT 5) s)\n) AS report FROM deleted;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "bc-03",
      "name": "Anything Deleted?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -220,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "d1",
              "leftValue": "={{ Number($json.report.rows_deleted) }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        },
        "options": {}
      }
    },
