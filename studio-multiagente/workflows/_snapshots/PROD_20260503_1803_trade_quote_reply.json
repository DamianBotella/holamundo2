        "responseBody": "={{ JSON.stringify({status:'received', quote_id: $('Apply Reply').first().json.id, supplier: $('Apply Reply').first().json.supplier_name, quote_status: $('Apply Reply').first().json.status, message: 'Gracias, hemos recibido tu respuesta. Revisaremos el presupuesto.'}) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
