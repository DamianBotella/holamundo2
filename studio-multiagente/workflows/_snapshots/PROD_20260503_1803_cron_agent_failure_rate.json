{
  "name": "cron_agent_failure_rate",
  "active": true,
  "nodes": [
    {
      "id": "afr-01",
      "name": "Daily 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "afr-02",
      "name": "Compute Rates",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        250,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH stats AS (SELECT agent_name, COUNT(*) AS total, COUNT(*) FILTER (WHERE status = 'failed') AS failed, COUNT(*) FILTER (WHERE status = 'completed') AS completed FROM agent_executions WHERE started_at > NOW() - INTERVAL '24 hours' AND agent_name IS NOT NULL AND agent_name != 'unknown_agent' GROUP BY agent_name HAVING COUNT(*) >= 2) SELECT json_agg(json_build_object('agent', agent_name, 'total', total, 'failed', failed, 'completed', completed, 'failure_rate', ROUND((failed::numeric / total::numeric) * 100, 1))) AS agents_with_high_failure FROM stats WHERE (failed::numeric / total::numeric) > 0.5;",
        "options": {
          "alwaysOutputData": true
        }
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "afr-03",
      "name": "Has Failures?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "f1",
              "leftValue": "={{ $json.agents_with_high_failure !== null && $json.agents_with_high_failure.length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "afr-04",
      "name": "Build Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        750,
        220
      ],
      "parameters": {
        "jsCode": "const failures = $('Compute Rates').first().json.agents_with_high_failure || [];\nconst rows = failures.map(f => `<tr><td><b>${f.agent}</b></td><td>${f.total}</td><td style=\"color:#dc2626\">${f.failed}</td><td>${f.completed}</td><td style=\"color:#dc2626;font-weight:bold\">${f.failure_rate}%</td></tr>`).join('\\n');\nconst html = `<div style=\"font-family:Arial;max-width:700px\"><h2 style=\"color:#dc2626\">[ArquitAI] Agentes con alta tasa de fallo (>50%)</h2><p>Las ultimas 24h muestran ejecuciones con fallo elevado. Revisar logs urgentemente.</p><table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse:collapse;width:100%;\"><thead><tr style=\"background:#f3f4f6\"><th>Agente</th><th>Total</th><th>Fallidas</th><th>OK</th><th>Tasa fallo</th></tr></thead><tbody>${rows}</tbody></table><p style=\"font-size:12px;color:#6b7280\">Cron diario 07:00. Analizado periodo: ultimas 24h. Umbral: failure_rate > 50% con minimo 2 ejecuciones.</p></div>`;\nreturn [{ json: { html, count: failures.length, agents_list: failures.map(f => f.agent).join(', ') } }];"
      }
    },
    {
      "id": "afr-05",
      "name": "Load Architect Email",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        750,
        380
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT value FROM system_config WHERE key='architect_email' LIMIT 1;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "afr-06",
      "name": "Send Alert",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $('Load Architect Email').first().json.value }}",
        "subject": "=[ArquitAI ALERT] {{ $('Build Email').first().json.count }} agente(s) con fallo >50% (24h): {{ $('Build Email').first().json.agents_list }}",
        "emailType": "html",
        "message": "={{ $('Build Email').first().json.html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "PLACEHOLDER",
          "name": "damian2botella"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "afr-07",
      "name": "Done",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1250,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "d1",
              "name": "status",
              "value": "ok",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "0e0abac5-f274-47a1-95d3-3127669fd543",
      "name": "Init Super Admin Context",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        120,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT set_config('app.role', 'super_admin', false) AS role_set"
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER",
          "name": "Postgres account"
        }
      }
    }
  ],
