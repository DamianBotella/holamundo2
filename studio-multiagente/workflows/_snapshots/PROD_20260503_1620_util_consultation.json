{
  "name": "util_consultation",
  "active": true,
  "nodes": [
    {
      "id": "uc000001-0000-0000-0000-000000000001",
      "name": "Receive Consultation",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "inputSource": "passthrough",
        "workflowInputs": {
          "values": [
            {
              "name": "project_id",
              "type": "string"
            },
            {
              "name": "agent_name",
              "type": "string"
            },
            {
              "name": "consultation_type",
              "type": "string"
            },
            {
              "name": "message",
              "type": "string"
            },
            {
              "name": "context",
              "type": "object"
            }
          ]
        }
      }
    },
    {
      "id": "uc000001-0000-0000-0000-000000000002",
      "name": "Check Architect Online",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        500,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT is_online FROM architect_status WHERE id = 1",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "uc000001-0000-0000-0000-000000000003",
      "name": "Queue Consultation",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        750,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO consultation_queue (project_id, agent_name, consultation_type, message, context) VALUES ($1::uuid, $2, $3, $4, $5::jsonb) RETURNING id",
        "options": {
          "queryReplacement": "={{ [\n  $('Receive Consultation').first().json.project_id || null,\n  $('Receive Consultation').first().json.agent_name,\n  $('Receive Consultation').first().json.consultation_type,\n  $('Receive Consultation').first().json.message,\n  JSON.stringify($('Receive Consultation').first().json.context || {})\n] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "uc000001-0000-0000-0000-000000000004",
      "name": "Is Directive Conflict?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "uc000001-cond-0001",
              "leftValue": "={{ $('Receive Consultation').first().json.consultation_type }}",
              "rightValue": "directive_conflict",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "uc000001-0000-0000-0000-000000000005",
      "name": "Send Conflict Alert",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        1250,
        180
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "ks2CqrtJCxLJTPdV",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "project_id": "={{ $('Receive Consultation').first().json.project_id }}",
            "type": "alert",
            "subject": "CONFLICTO DE DIRECTIVA — Respuesta requerida",
            "message": "=⚠️ CONFLICTO DE DIRECTIVA detectado por {{ $('Receive Consultation').first().json.agent_name }}:\n\n{{ $('Receive Consultation').first().json.message }}",
            "approval_id": "",
            "recipient": "={{ $('Load Architect Email').first().json.value }}"
          }
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "uc000001-0000-0000-0000-000000000006",
      "name": "Return Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1500,
        300
      ],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "uc000001-set-0001",
              "name": "queued",
              "value": true,
              "type": "boolean"
            },
            {
              "id": "uc000001-set-0002",
              "name": "channel",
              "value": "={{ $('Check Architect Online').first().json.is_online ? 'realtime' : 'queued' }}",
              "type": "string"
            },
            {
              "id": "uc000001-set-0003",
              "name": "consultation_id",
              "value": "={{ $('Queue Consultation').first().json.id }}",
              "type": "string"
            },
            {
              "id": "uc000001-set-0004",
              "name": "immediate_email",
              "value": false,
              "type": "boolean"
            }
          ]
        },
        "includeOtherFields": false
      }
    },
    {
      "id": "24773eb6-6aef-4a55-86d4-a18c8a714c7f",
      "name": "Load Architect Email",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        375,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT value FROM system_config WHERE key = 'architect_email'",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "3edc0105-97d8-4a6d-8430-561bc1021f38",
      "name": "Log Alert Error",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1250,
        400
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO activity_log (project_id, agent_name, action, status, error_message, output_summary, details) VALUES ($1::uuid, 'util_consultation', 'alert_send_failed_non_critical', 'warning', $2, 'Conflict alert email no enviado pero consulta encolada OK', $3::jsonb)",
        "options": {
          "queryReplacement": "={{ [$('Receive Consultation').first().json.project_id, (typeof $json.error === 'string' ? $json.error : (($json.error && $json.error.message) ? $json.error.message : 'Unknown')).substring(0,500), JSON.stringify({error: $json.error, execution_id: $execution.id || null, timestamp: new Date().toISOString()})] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER",
          "name": "Postgres account"
        }
      }
    }
  ],
