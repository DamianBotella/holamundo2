        "jsCode": "const sess = $('Decode JWT + Validate').first().json;\nconst proposalRows = $('Load Proposal').all().map(i => i.json).filter(p => p && p.id);\nif (proposalRows.length === 0) return [{ json: { _error: 'PROPOSAL_NOT_FOUND', _status: 404, _details: 'proposal_id no existe', request_id: sess.request_id }}];\nconst proposal = proposalRows[0];\nconst apikeyRows = $input.all().map(i => i.json).filter(k => k && k.value);\nif (apikeyRows.length === 0) return [{ json: { _error: 'MNML_API_KEY_NOT_CONFIGURED', _status: 503, _details: 'Falta system_config.mnml_api_key', request_id: sess.request_id }}];\nconst apiKey = apikeyRows[0].value;\nconst mb = proposal.moodboard_data || {};\nconst fallbackPrompt = 'photorealistic interior, warm light, modern, clean lines';\nconst prompt = sess.prompt_override || mb.render_prompt || fallbackPrompt;\nreturn [{ json: {\n  user_id: sess.user_id,\n  tenant_id: sess.tenant_id,\n  proposal_id: proposal.id,\n  project_id: proposal.project_id,\n  source_image_url: sess.source_image_url,\n  image_type: sess.image_type,\n  style: sess.style,\n  renderspeed: sess.renderspeed,\n  scenario: sess.scenario,\n  prompt: prompt.slice(0, 200),\n  mnml_api_key: apiKey,\n  request_id: sess.request_id\n}}];"
