    {
      "id": "ar-build-gremio",
      "name": "Build Gremio Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        60
      ],
      "parameters": {
        "jsCode": "const inc = $input.first().json;\nconst input = $('Validate Assign').first().json;\nconst sevColor = { urgent: '#dc2626', high: '#ea580c', medium: '#f59e0b', low: '#10b981' }[inc.severity] || '#6b7280';\nconst photos = (inc.photo_urls || []).map(u => '<a href=\"' + u + '\">foto</a>').join(' &middot; ') || '(sin fotos)';\nconst raw = inc.vision_raw || {};\nconst action = raw.action_recommended || '';\nconst body = '<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto\">' +\n  '<h2 style=\"color:#2c3e50\">Incidencia post-entrega asignada</h2>' +\n  '<p>Hola,</p>' +\n  '<p>Te asignamos esta incidencia post-entrega del cliente para que la atiendas:</p>' +\n  '<p><span style=\"background:' + sevColor + ';color:white;padding:2px 8px;border-radius:3px;font-weight:bold\">' + (inc.severity || '?').toUpperCase() + '</span>' +\n  (inc.under_warranty ? ' <span style=\"background:#10b981;color:white;padding:2px 8px;border-radius:3px;margin-left:6px\">EN GARANTIA LOE (' + (inc.loe_period || '?') + ' anios)</span>' : '') + '</p>' +\n  '<p><b>Descripcion del cliente:</b><br>' + (inc.description || '?') + '</p>' +\n  (inc.vision_summary ? '<p><b>Analisis tecnico automatico:</b><br>' + inc.vision_summary + '</p>' : '') +\n  (action ? '<p><b>Accion recomendada:</b> ' + action + '</p>' : '') +\n  (input.notes ? '<p><b>Notas adicionales del arquitecto:</b><br>' + input.notes + '</p>' : '') +\n  '<p><b>Fotos:</b> ' + photos + '</p>' +\n  '<hr>' +\n  '<p>Por favor, contacta con el cliente para programar la visita y nos avisas con la fecha prevista.</p>' +\n  '<p>Saludos,<br>Damian - Estudio</p>' +\n  '<p style=\"font-size:11px;color:#6b7280\">Ref incidencia: ' + inc.id + '</p>' +\n  '</div>';\nreturn [{ json: { html: body, to_email: input.notify_email, severity: inc.severity, incident_id: inc.id, description_preview: (inc.description || '').substring(0, 60) } }];"
      }
    },
    {
