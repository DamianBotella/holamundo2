-- Migration 052: VIEWS SQL para la API (X5)
-- Fecha planificada: X5 (API contract)
-- Estado: DRAFT - aplicar tras 049/050/051.
--
-- Estas views son LA INTERFAZ que los workflows api_* consumen. La UI Foxhole
-- nunca toca tablas raw, siempre VIEWS. Esto da:
-- 1. Compatibilidad: si cambia un schema, sólo hay que ajustar la VIEW.
-- 2. RLS automático: las views heredan las políticas de las tablas base.
-- 3. Performance: views pueden tener índices via materialización si hace falta.

BEGIN;

-- ============================================================
-- v_my_profile (ya creada en 051) - sólo referenciada
-- ============================================================

-- ============================================================
-- v_project_summary - lista de proyectos para /projects
-- ============================================================
CREATE OR REPLACE VIEW v_project_summary AS
SELECT
  p.id,
  p.name,
  c.name AS client_name,
  p.current_phase,
  p.status,
  p.budget_target,
  p.location_city,
  p.created_at,
  p.updated_at,
  p.tenant_id,
  COALESCE((
    SELECT count(*)::int FROM activity_log al
     WHERE al.project_id = p.id
       AND al.status IN ('warning', 'failed')
       AND al.created_at > now() - interval '30 days'
  ), 0) AS alerts_count,
  COALESCE((
    SELECT count(*)::int FROM approvals a
     WHERE a.project_id = p.id AND a.status = 'pending'
  ), 0) AS pending_approvals_count
FROM projects p
JOIN clients c ON c.id = p.client_id;

COMMENT ON VIEW v_project_summary IS
  'Lista de proyectos con KPIs agregados. Consumida por GET /projects.';

-- ============================================================
-- v_project_detail - detalle completo para /projects/{id}
-- ============================================================
CREATE OR REPLACE VIEW v_project_detail AS
SELECT
  p.*,
  c.name             AS client_name,
  c.email_enc        AS client_email_enc,
  c.phone_enc        AS client_phone_enc,
  c.preferred_contact AS client_preferred_contact,
  (
    SELECT row_to_json(b) FROM (
      SELECT id, version, summary, client_needs, objectives, constraints,
             rooms_affected, missing_info, open_questions, status,
             approved_at, created_at
        FROM briefings
       WHERE project_id = p.id
       ORDER BY version DESC LIMIT 1
    ) b
  ) AS briefing,
  (
    SELECT json_agg(d ORDER BY d.option_number) FROM (
      SELECT id, option_number, title, description, intervention_logic,
             rooms_layout, technical_notes, conflict_points, pros, cons,
             estimated_complexity, is_selected
        FROM design_options
       WHERE project_id = p.id
    ) d
  ) AS design_options,
  (
    SELECT json_agg(r ORDER BY r.priority, r.created_at) FROM (
      SELECT id, task_type, title, description, entity, required_docs,
             estimated_timeline, estimated_cost, priority, status,
             draft_message, normativa_confidence, citation_source
        FROM regulatory_tasks
       WHERE project_id = p.id
    ) r
  ) AS regulatory_tasks,
  (
    SELECT row_to_json(ce) FROM (
      SELECT id, version, total_estimated, budget_target, deviation_pct,
             deviation_status, breakdown, scenarios, status, created_at
        FROM cost_estimates
       WHERE project_id = p.id
       ORDER BY version DESC LIMIT 1
    ) ce
  ) AS cost_estimate,
  (
    SELECT row_to_json(pr) FROM (
      SELECT id, version, summary, total_amount, status, sent_at, created_at
        FROM proposals
       WHERE project_id = p.id
       ORDER BY version DESC LIMIT 1
    ) pr
  ) AS proposal,
  (
    SELECT row_to_json(pl) FROM (
      SELECT id, version, milestones, gantt, total_duration_days,
             estimated_start_date, status, created_at
        FROM project_plans
       WHERE project_id = p.id
       ORDER BY version DESC LIMIT 1
    ) pl
  ) AS project_plan,
  (
    SELECT row_to_json(sp) FROM (
      SELECT id, version, version_status, executive_summary,
             risks, training_required, prevention_resources, created_at
        FROM safety_plans
       WHERE project_id = p.id
       ORDER BY version DESC LIMIT 1
    ) sp
  ) AS safety_plan,
  (
    SELECT json_agg(aa) FROM (
      SELECT id, audit_type, compliance_status, findings, recommendations, created_at
        FROM accessibility_audits
       WHERE project_id = p.id
    ) aa
  ) AS accessibility_audits
FROM projects p
JOIN clients c ON c.id = p.client_id;

COMMENT ON VIEW v_project_detail IS
  'Detalle completo del proyecto con todas sus relaciones agregadas en JSON. Consumida por GET /projects/{id}.';

-- ============================================================
-- v_timeline - eventos cronológicos para /projects/{id}/timeline
-- ============================================================
CREATE OR REPLACE VIEW v_timeline AS
SELECT
  al.id,
  al.project_id,
  al.created_at AS timestamp,
  al.agent_name,
  al.action,
  al.status,
  al.output_summary,
  COALESCE(al.details, '{}'::jsonb) AS details,
  al.phase_at_time
FROM activity_log al;

COMMENT ON VIEW v_timeline IS
  'Eventos cronológicos del proyecto. Consumida por GET /projects/{id}/timeline.';

-- ============================================================
-- v_agent_runs - ejecuciones por proyecto
-- ============================================================
CREATE OR REPLACE VIEW v_agent_runs AS
SELECT
  ae.id,
  ae.project_id,
  ae.agent_name,
  ae.status,
  ae.started_at,
  ae.finished_at,
  CASE WHEN ae.finished_at IS NOT NULL
       THEN EXTRACT(EPOCH FROM (ae.finished_at - ae.started_at)) * 1000
       ELSE NULL
  END AS duration_ms,
  ae.cost_usd,
  ae.tokens_in,
  ae.tokens_out,
  ae.error_message AS error
FROM agent_executions ae;

COMMENT ON VIEW v_agent_runs IS
  'Ejecuciones de agentes con duración calculada. Consumida por GET /projects/{id}/agent-runs.';

-- ============================================================
-- v_alerts - vista unificada de alertas (UNION 4 fuentes)
-- ============================================================
CREATE OR REPLACE VIEW v_alerts AS
-- 1. Consultations pendientes
SELECT
  cq.id,
  cq.project_id,
  'consultation'::text AS type,
  CASE WHEN cq.consultation_type = 'directive_conflict' THEN 'critical'
       WHEN cq.consultation_type = 'decision' THEN 'warning'
       ELSE 'info'
  END AS severity,
  ('Consulta de ' || cq.agent_name)::text AS title,
  cq.message,
  cq.created_at,
  cq.answered_at AS resolved_at
FROM consultation_queue cq
WHERE cq.status IN ('pending', 'sent')

UNION ALL
-- 2. Approvals pendientes
SELECT
  a.id,
  a.project_id,
  'approval_pending'::text AS type,
  'warning'::text AS severity,
  ('Aprobación pendiente: ' || a.approval_type)::text AS title,
  COALESCE(a.message, 'Requiere decisión humana') AS message,
  a.created_at,
  a.decided_at AS resolved_at
FROM approvals a
WHERE a.status = 'pending'

UNION ALL
-- 3. Regulatory warnings (low confidence)
SELECT
  rt.id,
  rt.project_id,
  'regulatory_warning'::text AS type,
  CASE WHEN rt.priority = 'critico' THEN 'critical'
       WHEN rt.priority = 'importante' THEN 'warning'
       ELSE 'info'
  END AS severity,
  rt.title,
  COALESCE(rt.description, '')::text AS message,
  rt.created_at,
  CASE WHEN rt.status = 'completed' THEN rt.updated_at ELSE NULL END AS resolved_at
FROM regulatory_tasks rt
WHERE rt.status NOT IN ('completed', 'not_required')
  AND (rt.priority IN ('critico', 'importante') OR rt.normativa_confidence = 'low')

UNION ALL
-- 4. Agent failures recientes (últimos 7 días)
SELECT
  ae.id,
  ae.project_id,
  'agent_failure'::text AS type,
  'critical'::text AS severity,
  ('Fallo en ' || ae.agent_name)::text AS title,
  COALESCE(ae.error_message, 'Sin detalle') AS message,
  ae.started_at AS created_at,
  NULL::timestamptz AS resolved_at
FROM agent_executions ae
WHERE ae.status = 'failed'
  AND ae.started_at > now() - interval '7 days';

COMMENT ON VIEW v_alerts IS
  'Vista unificada de alertas: consultations + approvals + regulatory + agent failures. Consumida por /projects/{id}/alerts y /alerts/global.';

-- ============================================================
-- v_dashboard_metrics - KPIs para vista global Foxhole
-- ============================================================
CREATE OR REPLACE VIEW v_dashboard_metrics AS
WITH phase_counts AS (
  SELECT current_phase, count(*)::int AS cnt
  FROM projects
  WHERE status = 'active'
  GROUP BY current_phase
),
totals AS (
  SELECT
    count(*) FILTER (WHERE status = 'active')::int AS active_projects,
    count(*) FILTER (WHERE status = 'active' AND current_phase = 'completed')::int AS completed_projects,
    SUM(budget_target) FILTER (WHERE status = 'active')::numeric AS revenue_pipeline_eur,
    AVG(EXTRACT(EPOCH FROM (COALESCE(completed_at, now()) - COALESCE(started_at, created_at)))/86400)::numeric AS avg_cycle_days
  FROM projects
),
alert_counts AS (
  SELECT
    count(*) FILTER (WHERE severity = 'critical')::int AS critical_alerts,
    count(*) FILTER (WHERE type = 'approval_pending' AND resolved_at IS NULL)::int AS pending_approvals
  FROM v_alerts
  WHERE resolved_at IS NULL
),
llm_cost AS (
  SELECT COALESCE(SUM(cost_usd), 0)::numeric AS llm_cost_mtd_usd
  FROM agent_executions
  WHERE started_at >= date_trunc('month', now())
)
SELECT
  t.active_projects,
  jsonb_object_agg(pc.current_phase, pc.cnt) AS projects_by_phase,
  ac.critical_alerts,
  ac.pending_approvals,
  COALESCE(t.revenue_pipeline_eur, 0)::numeric(14,2) AS revenue_pipeline_eur,
  ROUND(COALESCE(t.avg_cycle_days, 0)::numeric, 2) AS avg_project_cycle_days,
  ROUND(lc.llm_cost_mtd_usd::numeric, 2) AS llm_cost_mtd_usd
FROM totals t
LEFT JOIN phase_counts pc ON true
LEFT JOIN alert_counts ac ON true
LEFT JOIN llm_cost lc ON true
GROUP BY t.active_projects, ac.critical_alerts, ac.pending_approvals,
         t.revenue_pipeline_eur, t.avg_cycle_days, lc.llm_cost_mtd_usd;

COMMENT ON VIEW v_dashboard_metrics IS
  'KPIs agregados del tenant para la vista mapa global Foxhole. Consumida por GET /metrics/dashboard. Cacheable 60s.';

-- ============================================================
-- v_recent_errors - errores de workflows clasificados (anti-PA-5)
-- ============================================================
CREATE OR REPLACE VIEW v_recent_errors AS
SELECT
  al.id,
  al.created_at,
  al.project_id,
  al.agent_name AS workflow_name,
  al.details->>'error_node'     AS error_node,
  al.details->>'error_category' AS error_category,
  al.details->>'error_hash'     AS error_hash,
  (al.details->>'is_critical')::boolean AS is_critical,
  al.details->>'error_message'  AS error_message,
  al.details->>'execution_id'   AS execution_id,
  al.details->>'url_to_execution' AS url_to_execution,
  -- count duplicados de la misma hash en las ultimas 24h
  (
    SELECT count(*)::int
      FROM activity_log al2
     WHERE al2.action = 'workflow_error'
       AND al2.created_at > now() - interval '24 hours'
       AND al2.details->>'error_hash' = al.details->>'error_hash'
  ) AS duplicate_count_24h
FROM activity_log al
WHERE al.action = 'workflow_error'
  AND al.created_at > now() - interval '7 days';

COMMENT ON VIEW v_recent_errors IS
  'Errores de workflows ultimos 7 dias con categoria + dedup. Consumida por GET /alerts/global y GET /projects/{id}/alerts (UNION en v_alerts).';

-- ============================================================
-- v_trade_overview - oficios cross-project para /trades
-- ============================================================
CREATE OR REPLACE VIEW v_trade_overview AS
SELECT
  ta.id,
  ta.project_id,
  p.name AS project_name,
  ta.trade_type,
  ta.contractor_name,
  ta.status,
  ta.estimated_cost,
  ta.scheduled_start,
  ta.created_at,
  p.tenant_id
FROM trade_assignments ta
JOIN projects p ON p.id = ta.project_id;

COMMENT ON VIEW v_trade_overview IS
  'Oficios + nombre de proyecto. Consumida por GET /trades.';

-- ============================================================
-- INSERT en applied_migrations
-- ============================================================
INSERT INTO applied_migrations (filename, applied_by, notes) VALUES (
  '052_api_views.sql',
  'X5-api-contract',
  'Crea 7 VIEWS SQL que la API consume directamente: v_project_summary, v_project_detail, v_timeline, v_agent_runs, v_alerts, v_dashboard_metrics, v_trade_overview. Las views heredan RLS de tablas base. La UI no toca tablas raw.'
);

COMMIT;
