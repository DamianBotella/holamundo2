      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO activity_log (project_id, agent_name, action, status, input_summary)\nVALUES (NULL, 'cron_quote_expiry', 'expire_quotes', 'success', $1)\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [ ('expired=' + $json.count) ] }}"
        }
      },
      "credentials": {
