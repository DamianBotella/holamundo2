      "name": "Purge access_log",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -460,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH purged AS (\n  DELETE FROM access_log\n   WHERE occurred_at < now() - INTERVAL '90 days'\n     AND pii_accessed = false\n     AND result NOT IN ('denied','error')\n  RETURNING id\n)\nSELECT json_build_object(\n  'rows_purged', count(*),\n  'remaining', (SELECT count(*) FROM access_log)\n) AS report FROM purged;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "ap-03",
      "name": "Anything?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -220,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "p1",
              "leftValue": "={{ Number($json.report.rows_purged) }}",
