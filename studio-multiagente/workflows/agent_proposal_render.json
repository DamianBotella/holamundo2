        "mode": "runOnceForAllItems",
        "jsCode": "const auth = $input.first().json.headers?.authorization || '';\nif (!auth.startsWith('Bearer ')) return [{ json: { _error: 'AUTH_MISSING_TOKEN', _status: 401 } }];\nconst token = auth.slice(7);\ntry {\n  const payload = JSON.parse(Buffer.from(token.split('.')[1], 'base64url').toString('utf8'));\n  if (!payload.sub) throw new Error('No sub');\n  if (payload.exp && Date.now()/1000 > payload.exp) throw new Error('JWT expired');\n  if (!payload.tenant_id) throw new Error('No tenant_id');\n  const body = $input.first().json.body || {};\n  const proposalId = (body.proposal_id || '').trim();\n  if (!proposalId) return [{ json: { _error: 'VALIDATION_FAILED', _status: 400, _details: 'proposal_id requerido' } }];\n  const sourceImageUrl = (body.source_image_url || '').trim();\n  if (!sourceImageUrl) return [{ json: { _error: 'VALIDATION_FAILED', _status: 400, _details: 'source_image_url requerido (URL accesible publicamente de foto/sketch/3dmass)' } }];\n  const validImageTypes = ['3dmass','photo','drawing','wireframe','construction'];\n  const imageType = validImageTypes.includes(body.image_type) ? body.image_type : 'photo';\n  const validStyles = ['realistic','night','sketch','watercolor','none'];\n  const style = validStyles.includes(body.style) ? body.style : 'realistic';\n  const validSpeeds = ['fast','best'];\n  const renderspeed = validSpeeds.includes(body.renderspeed) ? body.renderspeed : 'best';\n  const validScenarios = ['creative','precise'];\n  const scenario = validScenarios.includes(body.scenario) ? body.scenario : 'precise';\n  return [{ json: {\n    user_id: payload.sub,\n    tenant_id: payload.tenant_id,\n    role: payload.role || 'architect',\n    proposal_id: proposalId,\n    source_image_url: sourceImageUrl,\n    image_type: imageType,\n    style: style,\n    renderspeed: renderspeed,\n    scenario: scenario,\n    prompt_override: body.prompt_override || null,\n    request_id: 'req_' + Math.random().toString(36).slice(2, 10)\n  }}];\n} catch (e) {\n  return [{ json: { _error: 'AUTH_INVALID_TOKEN', _status: 401, _details: e.message } }];\n}"
