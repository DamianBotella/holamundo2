    {
      "parameters": {
        "jsCode": "const d = $('Compare and Classify').first().json;\nreturn [{json: {has_missing: d.missing_count > 0, missing_docs: d.missing_docs, new_registered: d.new_count, missing_count: d.missing_count, total_docs: d.total_docs, project_id: d.project_id, current_phase: d.current_phase}}];"
      },
      "id": "ad-11",
      "name": "After Files",
