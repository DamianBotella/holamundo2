      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        300
      ],
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst required = ['project_id','entity','application_type'];\nconst missing = required.filter(k => !body[k]);\nconst validTypes = ['licencia_obra_mayor','licencia_obra_menor','comunicacion_previa','declaracion_responsable','licencia_actividad','primera_ocupacion','cambio_uso','cedula_urbanistica','autorizacion_autonomica','otro'];\nif (missing.length > 0) {\n  return [{ json: { valid: false, error: 'Campos obligatorios faltantes: ' + missing.join(', ') } }];\n}\nif (!validTypes.includes(body.application_type)) {\n  return [{ json: { valid: false, error: 'application_type invalido. Permitidos: ' + validTypes.join(', ') } }];\n}\nconst out = {\n  valid: true,\n  project_id: body.project_id,\n  regulatory_task_id: body.regulatory_task_id || null,\n  entity: String(body.entity).trim(),\n  application_type: body.application_type,\n  expediente_id: body.expediente_id || null,\n  status: body.status || 'preparing',\n  submitted_at: body.submitted_at || null,\n  expected_response_days: Number(body.expected_response_days) || 30,\n  status_url: body.status_url || null,\n  notes: body.notes || null\n};\nreturn [{ json: out }];"
      }
    },
    {
      "id": "pr-03",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -220,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "v1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "pr-04",
      "name": "Insert Permit",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        20,
        220
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO permit_applications (\n  project_id, regulatory_task_id, entity, application_type, expediente_id,\n  status, submitted_at, expected_response_days, status_url, notes, last_checked_at\n) VALUES (\n  $1::uuid,\n  NULLIF($2,'')::uuid,\n  $3,\n  $4,\n  $5,\n  $6,\n  NULLIF($7,'')::timestamptz,\n  $8::int,\n  $9,\n  $10,\n  CASE WHEN NULLIF($7,'') IS NOT NULL THEN NULLIF($7,'')::timestamptz ELSE NULL END\n) RETURNING id, status, expediente_id, submitted_at, expected_response_days;",
        "options": {
          "queryReplacement": "={{ [ $json.project_id, $json.regulatory_task_id || '', $json.entity, $json.application_type, $json.expediente_id || '', $json.status, $json.submitted_at || '', $json.expected_response_days, $json.status_url || '', $json.notes || '' ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER",
          "name": "Postgres account"
        }
      }
    },
    {
