    {
      "id": "ar-02",
      "name": "Validate Assign",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        200
      ],
      "parameters": {
        "jsCode": "const body = $('Webhook Assign').first().json.body || {};\nif (!body.incident_id) { const e = { valid: false, error: 'incident_id obligatorio' }; return [{ json: e }]; }\nif (!body.assigned_to) { const e = { valid: false, error: 'assigned_to obligatorio' }; return [{ json: e }]; }\nconst emailMatch = (body.assigned_to || '').toString().match(/<([^>]+@[^>]+)>|^([^\\s@]+@[^\\s@]+\\.[^\\s@]+)$/);\nconst extractedEmail = emailMatch ? (emailMatch[1] || emailMatch[2]) : null;\nconst notifyEmail = body.notify_email_to || extractedEmail;\nconst out = {\n  valid: true,\n  incident_id: body.incident_id,\n  assigned_to: body.assigned_to.toString().slice(0, 200),\n  notify_email: notifyEmail,\n  notes: (body.notes || '').toString().slice(0, 1000)\n};\nreturn [{ json: out }];"
      }
    },
    {
      "id": "ar-03",
      "name": "Assign Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -220,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "v1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "ar-04",
      "name": "Apply Assign",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        20,
        120
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE aftercare_incidents\n   SET status = 'assigned',\n       assigned_to = $2,\n       assigned_at = now(),\n       notes = COALESCE(notes || E'\\n', '') || COALESCE(NULLIF($3,''), '')\n WHERE id = $1::uuid\nRETURNING id, status, assigned_to, responsible_trade, severity, description, photo_urls, vision_summary, vision_raw, project_id, loe_period, under_warranty;",
        "options": {
          "queryReplacement": "={{ [ $json.incident_id, $json.assigned_to, $json.notes || '' ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "cfxNZdzy0NB3xkYC",
          "name": "Postgres account"
        }
      }
    },
    {
