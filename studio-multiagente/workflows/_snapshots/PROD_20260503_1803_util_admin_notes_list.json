      "webhookId": "nl-trigger"
    },
    {
      "id": "nl-02",
      "name": "Load Notes",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -460,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH q AS (SELECT NULLIF(trim($1),'') AS pid)\nSELECT json_build_object(\n  'project_id', (SELECT pid FROM q),\n  'count', count(*),\n  'notes', json_agg(t.* ORDER BY t.pinned DESC, t.created_at DESC)\n) AS report FROM (\n  SELECT n.id, n.body, n.category, n.pinned, n.created_at, n.created_by,\n         p.id AS project_id, p.name AS project_name\n    FROM project_notes n\n    LEFT JOIN projects p ON p.id = n.project_id\n   WHERE (SELECT pid FROM q) IS NULL\n      OR n.project_id = (SELECT pid FROM q)::uuid\n) t;",
        "options": {
          "queryReplacement": "={{ [ ($('Webhook GET').first().json.query.project_id || '') ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "nl-03",
      "name": "Respond JSON",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        -220,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json.report) }}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Cache-Control",
                "value": "no-store"
              }
            ]
          }
        }
      }
    }
  ],
