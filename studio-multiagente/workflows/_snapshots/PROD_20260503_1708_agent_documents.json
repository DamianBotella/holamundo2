    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO activity_log (project_id, agent_name, action, phase_at_time, status, output_summary, details) VALUES ($1::uuid, 'agent_documents', 'missing_documents_detected', $2, 'warning', $3, $4::jsonb)",
        "options": {
          "queryReplacement": "={{ [$json.project_id, $json.current_phase, ($json.missing_docs || []).length + ' documentos faltantes detectados', JSON.stringify({missing_docs: $json.missing_docs, phase: $json.current_phase})] }}"
        }
