    {
      "id": "tr-02",
      "name": "Extract Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        300
      ],
      "parameters": {
        "jsCode": "const wh = $('Webhook').first().json;\nconst token = (wh.query && wh.query.token) || (wh.body && wh.body.token) || null;\nif (!token) { const e = { valid: false, error: 'token obligatorio (en query o body)' }; return [{ json: e }]; }\nconst body = wh.body || {};\nconst out = {\n  valid: true,\n  token: token,\n  amount: body.amount ? Number(body.amount) : null,\n  currency: body.currency || 'EUR',\n  payment_terms: (body.payment_terms || '').toString().slice(0, 500),\n  estimated_duration: (body.estimated_duration || '').toString().slice(0, 200),\n  reply_text: (body.reply_text || body.notes || '').toString().slice(0, 4000),\n  status: body.status || 'quoted'\n};\nreturn [{ json: out }];"
      }
    },
    {
      "id": "tr-03",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -220,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "v1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "tr-04",
      "name": "Apply Reply",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        20,
        220
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE trade_quotes SET\n  status = CASE WHEN $1 IN ('quoted','rejected_by_supplier','accepted','withdrawn') THEN $1 ELSE 'quoted' END,\n  amount = NULLIF($2,'')::numeric,\n  currency = COALESCE(NULLIF($3,''), currency),\n  payment_terms = COALESCE(NULLIF($4,''), payment_terms),\n  estimated_duration = COALESCE(NULLIF($5,''), estimated_duration),\n  reply_text = $6,\n  reply_received_at = now()\n WHERE webhook_token = $7\nRETURNING id, project_id, supplier_name, status, amount;",
        "options": {
          "queryReplacement": "={{ [ $json.status, $json.amount === null || $json.amount === undefined ? '' : String($json.amount), $json.currency, $json.payment_terms, $json.estimated_duration, $json.reply_text, $json.token ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "tr-05",
