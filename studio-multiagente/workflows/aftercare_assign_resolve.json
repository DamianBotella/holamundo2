        "subject": "=Incidencia post-entrega - [{{ ($json.severity || 'medium').toUpperCase() }}] {{ $json.description_preview }}",
        "emailType": "html",
        "message": "={{ $json.html }}",
        "options": {
          "appendAttribution": false,
          "ccList": "={{ $('Load Architect Email').first().json.value }}"
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "cIma8ntTjZvIfU3H",
          "name": "damian2botella"
        }
