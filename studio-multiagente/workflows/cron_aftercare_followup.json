      "webhookId": "ceb8dcf5-8c9c-4688-b9ba-5847c02f9720"
    },
    {
      "id": "af-03",
      "name": "Find Stuck Assigned",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -460,
        400
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT json_agg(row_to_json(t) ORDER BY t.days_assigned DESC) AS rows\nFROM (\n  SELECT ai.id, ai.severity, ai.category, ai.responsible_trade,\n         ai.assigned_to, ai.assigned_at,\n         LEFT(ai.description, 120) AS preview,\n         p.name AS project_name,\n         round((EXTRACT(EPOCH FROM (now() - ai.assigned_at))/86400)::numeric, 1) AS days_assigned\n  FROM aftercare_incidents ai\n  JOIN projects p ON p.id = ai.project_id\n  WHERE ai.status = 'assigned'\n    AND ai.assigned_at IS NOT NULL\n    AND ai.assigned_at < now() - INTERVAL '4 days'\n) t;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "cfxNZdzy0NB3xkYC",
          "name": "Postgres account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "af-04",
      "name": "Has Stuck?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -220,
        400
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "h1",
              "leftValue": "={{ ($json.rows && $json.rows.length) || 0 }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "af-05",
      "name": "Build Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        320
      ],
      "parameters": {
        "jsCode": "const list = $input.first().json.rows || [];\nconst sevColor = { urgent: '#dc2626', high: '#ea580c', medium: '#f59e0b', low: '#10b981' };\nconst rows = list.map(p => '<tr>' +\n  '<td><span style=\"background:' + (sevColor[p.severity] || '#6b7280') + ';color:white;padding:2px 6px;border-radius:3px\">' + (p.severity || '?').toUpperCase() + '</span></td>' +\n  '<td><b>' + (p.project_name || '?') + '</b><br><small>' + (p.category || '?') + ' / ' + (p.responsible_trade || '?') + '</small></td>' +\n  '<td>' + (p.assigned_to || '?') + '</td>' +\n  '<td>' + p.days_assigned + ' d</td>' +\n  '<td><small>' + (p.preview || '') + '</small></td>' +\n  '</tr>').join('');\nconst urgent = list.filter(p => p.severity === 'urgent').length;\nconst html = '<h2>Aftercare followup - incidencias asignadas sin avance</h2>' +\n  '<p>Total: <b>' + list.length + '</b>. Urgentes: <b style=\"color:#dc2626\">' + urgent + '</b>.</p>' +\n  '<p>Estas incidencias llevan mas de 4 dias en status <code>assigned</code> sin pasar a <code>in_progress</code> ni <code>resolved</code>. Considera contactar al gremio de nuevo o reasignar.</p>' +\n  '<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse:collapse;font-family:sans-serif;font-size:13px\">' +\n  '<thead><tr style=\"background:#f3f4f6\"><th>Sev.</th><th>Proyecto / Categoria</th><th>Asignado a</th><th>Dias</th><th>Descripcion</th></tr></thead>' +\n  '<tbody>' + rows + '</tbody></table>' +\n  '<p style=\"font-size:11px;color:#6b7280\">Para marcar in_progress: actualizar status manualmente. Para resolver: POST /webhook/aftercare-resolve.</p>';\nreturn [{ json: { html_body: html, count: list.length, urgent: urgent } }];"
      }
    },
    {
      "id": "af-06",
      "name": "Send Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
