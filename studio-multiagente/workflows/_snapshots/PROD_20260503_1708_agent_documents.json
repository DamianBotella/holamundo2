        "query": "INSERT INTO activity_log (project_id, agent_name, action, phase_at_time, status, output_summary, details) VALUES ($1::uuid, 'agent_documents', 'documents_processed', $2, 'success', $3, $4::jsonb)",
        "options": {
          "queryReplacement": "={{ [$('After Files').first().json.project_id, $('After Files').first().json.current_phase, $('After Files').first().json.new_registered + ' docs nuevos / ' + $('After Files').first().json.total_docs + ' totales / ' + $('After Files').first().json.missing_count + ' faltantes', JSON.stringify({new_registered: $('After Files').first().json.new_registered, missing_count: $('After Files').first().json.missing_count, total_docs: $('After Files').first().json.total_docs, phase: $('After Files').first().json.current_phase})] }}"
        }
      },
