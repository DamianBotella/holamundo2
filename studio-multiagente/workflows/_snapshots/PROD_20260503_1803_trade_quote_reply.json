          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "m1",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "tr-06",
      "name": "Notify Damian",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        480,
        140
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $('Load Architect Email').first().json.value }}",
        "subject": "=Respuesta gremio: {{ $json.supplier_name }} — {{ $json.amount ? $json.amount + 'eur' : 'sin importe' }}",
        "emailType": "html",
        "message": "=<h3>Respuesta de presupuesto</h3><p><b>Gremio:</b> {{ $json.supplier_name }}</p><p><b>Estado:</b> {{ $json.status }}</p><p><b>Importe:</b> {{ $json.amount ? $json.amount + ' EUR' : '—' }}</p><p><b>Texto recibido:</b><br>{{ $('Extract Token').first().json.reply_text }}</p><p style=\"font-size:11px;color:#6b7280\">Quote ID: {{ $json.id }}</p>",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "PLACEHOLDER",
          "name": "damian2botella"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
