      "webhookId": "323bf198-3b79-48d8-901c-fa90cf660387"
    },
    {
      "id": "cp-02",
      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        300
      ],
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nif (!body.certification_id) { const e = { valid: false, error: 'certification_id obligatorio' }; return [{ json: e }]; }\nif (!body.paid_amount || isNaN(Number(body.paid_amount)) || Number(body.paid_amount) <= 0) {\n  const e = { valid: false, error: 'paid_amount > 0 obligatorio' };\n  return [{ json: e }];\n}\nconst out = {\n  valid: true,\n  certification_id: body.certification_id,\n  paid_amount: Number(body.paid_amount),\n  paid_at: body.paid_at || null,\n  payment_reference: (body.payment_reference || '').toString().slice(0, 100)\n};\nreturn [{ json: out }];"
      }
    },
    {
      "id": "cp-03",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -220,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "v1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "cp-04",
      "name": "Apply Payment",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        20,
        220
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE certifications\n   SET paid_amount = COALESCE(paid_amount, 0) + $2::numeric,\n       paid_at = COALESCE(paid_at, COALESCE(NULLIF($3,'')::timestamptz, now())),\n       payment_reference = COALESCE(NULLIF($4,''), payment_reference),\n       status = CASE\n         WHEN COALESCE(paid_amount, 0) + $2::numeric >= amount THEN 'paid'\n         ELSE 'partially_paid'\n       END\n WHERE id = $1::uuid\nRETURNING id, version, amount, paid_amount, status, payment_reference;",
        "options": {
          "queryReplacement": "={{ [ $json.certification_id, $json.paid_amount, $json.paid_at || '', $json.payment_reference || '' ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "cp-05",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        240,
        220
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({status:'paid_applied', certification_id: $json.id, version: $json.version, amount: $json.amount, paid_total: $json.paid_amount, certification_status: $json.status, payment_reference: $json.payment_reference}) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "cp-06",
      "name": "Respond 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        20,
        400
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({status:'error', error: $json.error}) }}",
        "options": {
          "responseCode": 400
        }
      }
    }
  ],
